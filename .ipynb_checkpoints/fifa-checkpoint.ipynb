   "source": [
    "import pandas as pd\n",
    "dados = pd.read_csv('arquivos/fifa.csv')\n",
    "dados.head()\n",
    "dados.iloc[2, 2]\n",
    "dados['total'] = dados['Reactions'] + dados['Acceleration'] + dados['Agility']\n",
    "dados = dados[['Name', 'Age', 'total']]\n",
    "dados.sort_values('total')"
   ]
  }
